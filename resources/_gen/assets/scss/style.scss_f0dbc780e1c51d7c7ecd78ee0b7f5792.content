  border: 1px solid rgba(11, 15, 23, 0.12);
  border-radius: 4px;
  color: #0b0f17;
  transition: border-color 0.15s ease; }
  .confirmed-beat:hover, .confirmed-beat:focus-visible {
    border-color: #f59e0b;
