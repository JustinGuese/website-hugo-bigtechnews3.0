  margin-bottom: 18px; }

.newsletter-modal {
  position: fixed;
  inset: 0;
  z-index: 1080;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  overflow-y: auto; }
  .newsletter-modal[hidden] {
    display: none; }

.newsletter-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(11, 15, 23, 0.66); }

.newsletter-modal-card {
  position: relative;
  width: 100%;
  max-width: 480px;
  margin: auto;
  padding: 40px 38px 32px;
  background: #ffffff;
  border-top: 3px solid #f59e0b;
  box-shadow: 0 24px 60px rgba(11, 15, 23, 0.28);
  animation: newsletter-modal-in 0.22s ease-out both; }
  @media (max-width: 575px) {
    .newsletter-modal-card {
      padding: 32px 22px 26px; } }
@keyframes newsletter-modal-in {
  from {
    opacity: 0;
    transform: translateY(12px); } }

.newsletter-modal-eyebrow {
  margin-bottom: 6px;
  color: #f59e0b;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em; }

.newsletter-modal-title {
  font-family: "Bricolage Grotesque", sans-serif;
  font-size: 24px;
  line-height: 1.25;
  color: #0b0f17;
  margin-bottom: 12px; }

.newsletter-modal-body {
  color: #66676d;
  font-size: 15px;
  margin-bottom: 24px; }

.newsletter-modal-close {
