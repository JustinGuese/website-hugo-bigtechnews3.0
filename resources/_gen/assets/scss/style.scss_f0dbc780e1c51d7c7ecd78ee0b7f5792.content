    border-radius: 4px;
    background: rgba(30, 126, 69, 0.1);
    color: #1e7e45 !important;
    font-weight: 600;
    line-height: 1.4; }
    .subscribe-form .subscribe-status.subscribe-status--success::before {
      content: '\2713';
      flex: 0 0 auto;
