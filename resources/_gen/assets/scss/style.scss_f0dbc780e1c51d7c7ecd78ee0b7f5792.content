    .phone .phone-chip--tech, .phone .phone-chip[data-beat="tech"], .phone .phone-chip.beat-tech,
    [data-phone] .phone-chip--tech,
    [data-phone] .phone-chip[data-beat="tech"],
    [data-phone] .phone-chip.beat-tech {
      border-color: oklch(0.76 0.21 45/0.5);
      color: var(--beat-tech);
