    letter-spacing: -0.02em;
    margin-bottom: 48px; }
  .app-section .app-feature-col,
  .app-section .app-feature-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 32px 24px;
    text-align: center;
