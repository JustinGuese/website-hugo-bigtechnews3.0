  letter-spacing: 0.02em;
  cursor: pointer;
  transition: background-color 0.15s ease; }
  .subscribe-submit-block:hover {
    background: #0b0f17; }
  .subscribe-submit-block:disabled {
    opacity: 0.55;
    cursor: default; }

.newsletter-block-body {
  max-width: 480px;
  margin: 0 auto 22px;
  color: #66676d;
  font-size: 15px; }

footer .newsletter-block .beat-picker,
footer .newsletter-block .consent-check,
footer .newsletter-block .subscribe-status {
  max-width: 350px;
  margin-left: auto;
  margin-right: auto; }

footer .newsletter-block .beat-chips {
