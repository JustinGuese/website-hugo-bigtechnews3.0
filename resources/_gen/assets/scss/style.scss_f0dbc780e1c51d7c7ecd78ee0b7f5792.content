.subscribe-form .subscribe-status {
  min-height: 1.2em;
  margin-top: 10px; }
  .subscribe-form .subscribe-status.text-danger {
    color: #c0392b !important; }
  .subscribe-form .subscribe-status.subscribe-status--success {
    display: flex;
    align-items: flex-start;
    gap: 8px;
