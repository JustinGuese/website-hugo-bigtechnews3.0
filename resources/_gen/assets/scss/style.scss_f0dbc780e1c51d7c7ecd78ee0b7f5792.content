  @media (max-width: 480px) {
    .phone,
    [data-phone] {
      width: 240px;
      max-width: calc(100% - 40px); }
      .phone .phone-chip,
      [data-phone] .phone-chip {
        padding: 4px 10px;
        font-size: 10px; }
        .phone .phone-chip:nth-of-type(1),
