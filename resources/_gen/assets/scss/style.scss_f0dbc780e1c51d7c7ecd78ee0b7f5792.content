  border-radius: 14px;
  background: var(--accent);
  border-color: var(--accent);
  box-shadow: 0 10px 30px -8px oklch(0.78 0.17 70/0.5); }
  .hero-app .store-badge,
  .hero-app .store-badge .store-badge-title {
    color: var(--accent-ink) !important; }
  .hero-app .store-badge .store-badge-sub {
    color: oklch(0.3 0.06 70);
    font-size: 11px; }
  .hero-app .store-badge .store-badge-title {
    font-size: 20px; }
  .hero-app .store-badge svg {
    width: 32px;
    height: 32px; }
  .hero-app .store-badge:hover, .hero-app .store-badge:focus-visible {
    background: oklch(0.84 0.15 80);
    color: var(--accent-ink) !important; }

.hero-app .store-badge--android {
  background: transparent;
  box-shadow: none;
  border-color: var(--accent); }
  .hero-app .store-badge--android,
  .hero-app .store-badge--android .store-badge-title {
    color: var(--ink) !important; }
  .hero-app .store-badge--android .store-badge-sub {
    color: var(--muted); }
  .hero-app .store-badge--android:hover, .hero-app .store-badge--android:focus-visible {
    background: oklch(0.26 0.03 260);
    color: var(--ink) !important; }

.page-content .row > [class*='col-xl-4'] {
  display: flex; }
  .page-content .row > [class*='col-xl-4'] > * {
    width: 100%; }
  .page-content .row > [class*='col-xl-4'] .card,
  .page-content .row > [class*='col-xl-4'] article {
    height: calc(100% - 30px); }

header.sidenav .search-toggle,
header.sidenav select,
header.sidenav .social-links a {
  color: var(--ink) !important;
  background-color: transparent !important; }
  header.sidenav .search-toggle:hover, header.sidenav .search-toggle:focus-visible,
  header.sidenav select:hover,
  header.sidenav select:focus-visible,
  header.sidenav .social-links a:hover,
  header.sidenav .social-links a:focus-visible {
