    flex-direction: column;
    align-items: center;
    height: 100%;
    box-sizing: border-box;
    max-width: 100%;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease; }
    .app-section .app-feature-col:hover,
    .app-section .app-feature-card:hover {
      transform: translateY(-4px);
      border-color: var(--accent);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6); }
    .app-section .app-feature-col img,
    .app-section .app-feature-card img {
      max-width: 200px;
      width: 100%;
      height: auto;
      border-radius: 16px;
      margin-bottom: 24px;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5); }
    .app-section .app-feature-col h3,
    .app-section .app-feature-col .app-feat-title,
    .app-section .app-feature-card h3,
    .app-section .app-feature-card .app-feat-title {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--ink);
      margin-bottom: 10px; }
    .app-section .app-feature-col p,
    .app-section .app-feature-col .app-feat-desc,
    .app-section .app-feature-card p,
    .app-section .app-feature-card .app-feat-desc {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.55;
      margin-bottom: 0; }
  .app-section .app-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 40px; }

.site-footer-app {
  border-top: 1px solid var(--line);
  padding: 48px 0 32px;
  margin-top: 64px;
  box-sizing: border-box;
  text-align: center;
  max-width: 100%; }
  .site-footer-app .footer-badges,
  .site-footer-app .app-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 24px; }
  .site-footer-app .footer-pills,
  .site-footer-app .rss-pills,
  .site-footer-app .social-pills {
    display: flex;
    flex-wrap: wrap;
