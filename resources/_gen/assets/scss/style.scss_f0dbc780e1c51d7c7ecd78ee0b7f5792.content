  cursor: pointer; }
  .newsletter-modal-close:hover {
    color: #0b0f17; }

.newsletter-modal-decline {
  display: block;
  width: 100%;
  margin-top: 14px;
  padding: 4px;
  border: 0;
  background: transparent;
  color: #a8aab2;
  font-size: 13px;
  text-decoration: underline;
  cursor: pointer; }
  .newsletter-modal-decline:hover {
    color: #0b0f17; }

body.newsletter-modal-open {
  overflow: hidden; }

@media (prefers-reduced-motion: reduce) {
  .newsletter-modal-card {
    animation: none; }
  .beat-chip,
  .subscribe-submit-block {
    transition: none; } }

.category-strip .category-chip {
  display: inline-block;
  padding: 7px 18px;
  margin: 0 8px 8px 0;
  border-radius: 30px;
  background: #f59e0b;
  color: #ffffff;
  font-weight: 600;
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.03em; }
  .category-strip .category-chip:hover {
    background: #0b0f17;
    color: #ffffff;
    text-decoration: none; }

.beat-landing-inner {
  max-width: 640px;
  border-bottom: 1px solid rgba(11, 15, 23, 0.1); }

.beat-landing-eyebrow {
  margin-bottom: 0.5rem;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #f59e0b; }

.beat-landing-title {
  margin-bottom: 0.75rem;
  font-family: "Instrument Sans", sans-serif; }

.beat-landing-blurb {
  font-size: 1.1rem;
  color: #0b0f17; }

.beat-landing-cadence {
  color: #66676d; }

.beat-landing-form {
  margin-top: 1.25rem; }

.beat-landing-examples {
  margin: 0.5rem 0 1.5rem;
