.phone,
[data-phone] {
  position: relative;
  width: 270px;
  max-width: 82vw;
  aspect-ratio: 9 / 19.5;
  background: #000;
  border: 7px solid oklch(0.25 0.02 260);
  border-radius: 40px;
  box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.8), 0 0 0 1px oklch(0.32 0.025 260), 0 0 35px -8px oklch(0.78 0.17 70/0.15);
  perspective: 1000px;
  transform-style: preserve-3d;
  will-change: transform;
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  box-sizing: border-box; }
  .phone::after,
  [data-phone]::after {
    content: '';
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 64px;
    height: 16px;
    background: #000;
    border-radius: 10px;
    z-index: 10; }
  .phone .phone-screen,
  [data-phone] .phone-screen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 32px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.6s ease;
    z-index: 1; }
    .phone .phone-screen:first-child,
    [data-phone] .phone-screen:first-child {
      opacity: 1;
      visibility: visible;
      z-index: 2; }
    .phone .phone-screen.is-active, .phone .phone-screen.active, .phone .phone-screen[data-active="true"],
    [data-phone] .phone-screen.is-active,
    [data-phone] .phone-screen.active,
    [data-phone] .phone-screen[data-active="true"] {
      opacity: 1;
      visibility: visible;
      z-index: 3; }
    .phone .phone-screen.is-inactive, .phone .phone-screen.inactive,
    [data-phone] .phone-screen.is-inactive,
    [data-phone] .phone-screen.inactive {
      opacity: 0;
      visibility: hidden;
      z-index: 1; }
  .phone .phone-chip,
  [data-phone] .phone-chip {
    position: absolute;
    z-index: 15;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 30px;
    font-size: 11px;
    font-weight: 700;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: oklch(0.19 0.025 260/0.88);
    color: var(--ink);
    border: 1px solid var(--line);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    white-space: nowrap;
    animation: phone-chip-float 4.5s ease-in-out infinite alternate; }
    .phone .phone-chip:nth-child(even), .phone .phone-chip--alt,
    [data-phone] .phone-chip:nth-child(even),
    [data-phone] .phone-chip--alt {
      animation-duration: 5.5s;
      animation-delay: -2.25s; }
    .phone .phone-chip:nth-of-type(1),
    [data-phone] .phone-chip:nth-of-type(1) {
      top: 18%;
      left: -28px; }
    .phone .phone-chip:nth-of-type(2),
    [data-phone] .phone-chip:nth-of-type(2) {
      top: 55%;
      right: -28px; }
    .phone .phone-chip:nth-of-type(3),
    [data-phone] .phone-chip:nth-of-type(3) {
      bottom: 14%;
      left: -20px; }
    .phone .phone-chip--ai, .phone .phone-chip[data-beat="ai"], .phone .phone-chip.beat-ai,
    [data-phone] .phone-chip--ai,
    [data-phone] .phone-chip[data-beat="ai"],
    [data-phone] .phone-chip.beat-ai {
      border-color: oklch(0.74 0.23 305/0.5);
      color: var(--beat-ai);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 16px oklch(0.74 0.23 305/0.25); }
    .phone .phone-chip--crypto, .phone .phone-chip[data-beat="crypto"], .phone .phone-chip.beat-crypto,
    [data-phone] .phone-chip--crypto,
    [data-phone] .phone-chip[data-beat="crypto"],
    [data-phone] .phone-chip.beat-crypto {
      border-color: oklch(0.8 0.19 85/0.5);
      color: var(--beat-crypto);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 16px oklch(0.8 0.19 85/0.25); }
    .phone .phone-chip--devops, .phone .phone-chip[data-beat="devops"], .phone .phone-chip.beat-devops,
    [data-phone] .phone-chip--devops,
    [data-phone] .phone-chip[data-beat="devops"],
    [data-phone] .phone-chip.beat-devops {
      border-color: oklch(0.75 0.22 145/0.5);
      color: var(--beat-devops);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 16px oklch(0.75 0.22 145/0.25); }
    .phone .phone-chip--fintech, .phone .phone-chip[data-beat="fintech"], .phone .phone-chip.beat-fintech,
    [data-phone] .phone-chip--fintech,
    [data-phone] .phone-chip[data-beat="fintech"],
    [data-phone] .phone-chip.beat-fintech {
      border-color: oklch(0.77 0.18 175/0.5);
      color: var(--beat-fintech);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 16px oklch(0.77 0.18 175/0.25); }
    .phone .phone-chip--founders, .phone .phone-chip[data-beat="founders"], .phone .phone-chip.beat-founders,
    [data-phone] .phone-chip--founders,
