    color: #0b0f17; }

.confirmed-beat-name {
  display: block;
  margin-bottom: 0.25rem;
  font-family: "Instrument Sans", sans-serif;
  font-weight: 600; }

.confirmed-beat-blurb {
  display: block;
  font-size: 0.9rem;
  color: #66676d; }

.confirmed-share {
  max-width: 640px; }

.confirmed-share-row {
  display: flex;
  gap: 0.5rem; }
  .confirmed-share-row .form-control {
    flex: 1 1 auto;
    min-width: 0; }
  .confirmed-share-row .btn {
    flex: 0 0 auto; }

:root {
  --bg: oklch(0.14 0.025 260);
  --surface: oklch(0.19 0.025 260);
  --surface-2: oklch(0.24 0.03 260);
  --line: oklch(0.30 0.025 260);
  --ink: oklch(0.96 0.01 260);
  --muted: oklch(0.70 0.02 260);
  --accent: oklch(0.78 0.17 70);
  --accent-ink: oklch(0.14 0.03 260);
  --beat-ai: oklch(0.74 0.23 305);
  --beat-crypto: oklch(0.80 0.19 85);
  --beat-devops: oklch(0.75 0.22 145);
  --beat-fintech: oklch(0.77 0.18 175);
  --beat-founders: oklch(0.73 0.24 350);
  --beat-it: oklch(0.72 0.20 250);
  --beat-tech: oklch(0.76 0.21 45);
  --app-banner-h: 0px;
  --font-display: 'Bricolage Grotesque', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-body: 'Instrument Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-mono: 'Geist Mono', 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }

*,
*::before,
*::after {
  box-sizing: border-box; }

html {
  background-color: var(--bg);
  color: var(--ink);
  overflow-x: hidden;
  max-width: 100vw; }

body {
  background-color: var(--bg) !important;
  color: var(--ink) !important;
  font-family: var(--font-body) !important;
  overflow-x: hidden;
  max-width: 100vw;
  position: relative;
  min-height: 100vh;
  margin: 0; }
  body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9999;
    opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E"); }
  body::-webkit-scrollbar {
    width: 10px;
    background-color: var(--bg); }
  body::-webkit-scrollbar-thumb {
    background-color: var(--surface-2);
    border-radius: 5px;
    border: 2px solid var(--bg); }
    body::-webkit-scrollbar-thumb:hover {
      background-color: var(--accent); }

h1, h2, h3, h4, h5, h6,
.h1, .h2, .h3, .h4, .h5, .h6 {
  font-family: var(--font-display) !important;
  color: var(--ink) !important;
  letter-spacing: -0.015em; }

p, span, li, label {
  color: inherit; }

.text-muted,
.text-light {
  color: var(--muted) !important; }

.text-dark {
  color: var(--ink) !important; }

.text-primary {
  color: var(--accent) !important; }

a {
  color: var(--ink);
  transition: color 0.15s ease, opacity 0.15s ease; }
  a:hover {
    color: var(--accent) !important;
    text-decoration: none; }

:focus-visible {
  outline: 2px solid var(--accent) !important;
  outline-offset: 2px !important; }

a:focus-visible,
button:focus-visible,
input:focus-visible {
  outline: 2px solid var(--accent) !important;
  outline-offset: 2px !important; }

header.sidenav {
  background-color: var(--surface) !important;
  border-right: 1px solid var(--line) !important;
  color: var(--ink);
  transition: top 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease; }
  header.sidenav .sidenav-toggler .toggler-icon .line {
    stroke: var(--ink) !important; }
  header.sidenav .navbar-brand {
    color: var(--ink) !important; }
  @media (max-width: 991.98px) {
    header.sidenav {
      top: var(--app-banner-h, 0px) !important;
      background-color: var(--surface) !important;
      border-right: 0 !important;
      border-bottom: 1px solid var(--line) !important; } }
@media (max-width: 767.98px) {
  html.has-app-banner header.sidenav {
    top: var(--app-banner-h, 56px) !important; } }

@media (max-width: 767.98px) {
  html.has-app-banner .page-content {
    margin-top: calc(80px + var(--app-banner-h, 56px)) !important; } }

.sidenav-overlay {
  background-color: var(--bg) !important; }
  .sidenav-overlay .navigation .nav-link {
    font-family: var(--font-display);
    color: var(--ink) !important; }
    .sidenav-overlay .navigation .nav-link:hover, .sidenav-overlay .navigation .nav-link.active {
      color: var(--accent) !important; }

.app-banner,
[data-app-banner] {
  display: none; }
  .app-banner[hidden],
  [data-app-banner][hidden] {
    display: none !important; }

@media (max-width: 767.98px) {
  html.has-app-banner .app-banner:not([hidden]) {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 60px;
    z-index: 1050;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
    box-sizing: border-box; }
  .app-banner-inner {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 100%;
    padding: 0 10px 0 2px; }
  .app-banner-close {
    order: 0;
    flex: 0 0 auto;
    width: 40px;
    height: 44px;
    background: transparent;
    border: 0;
    color: var(--muted);
    font-size: 24px;
    line-height: 1;
    cursor: pointer; }
    .app-banner-close:hover, .app-banner-close:focus-visible {
      color: var(--ink); }
  .app-banner-icon {
    order: 1;
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    border-radius: 9px;
    object-fit: cover; }
  .app-banner-text {
    order: 2;
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    line-height: 1.25; }
  .app-banner-title {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis; }
  .app-banner-sub {
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis; }
  .app-banner-actions {
    order: 3;
    flex: 0 0 auto;
    display: flex;
    gap: 6px; }
  .app-banner .app-banner-cta.store-badge {
    min-height: 44px;
    padding: 0 16px;
    border-radius: 22px;
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: none;
    color: var(--accent-ink) !important;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    justify-content: center; }
    .app-banner .app-banner-cta.store-badge[hidden] {
      display: none !important; }
    .app-banner .app-banner-cta.store-badge.app-banner-cta--alt {
      background: transparent;
      color: var(--ink) !important; } }

.store-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-height: 44px;
  padding: 7px 16px;
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-radius: 10px;
  color: var(--ink) !important;
  text-decoration: none !important;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  user-select: none;
